  "codigos": {
    "escenas": [
      {
        "nombre": "portada",
        "codigo": "// Escena 1: PORTADA del recurso (identidad visual de la UNL)\nclass portada extends Escena {\n  iniciar() {\n    let p = this.proyecto;\n    let c = p.colores;\n\n    p.plantilla(\"\");\n\n    // Franja superior roja, como en el brochure de la carrera\n    p.rectangulo(0, 225, 800, 150, c.granate, { radio: 0, profundidad: -40 });\n    let franja = this.pilas.modo.add.graphics();\n    franja.fillStyle(p.color_numerico(c.granate_oscuro), 1);\n    franja.fillTriangle(430, 0, 800, 0, 800, 150);\n    franja.fillStyle(p.color_numerico(c.amarillo), 1);\n    franja.fillRect(0, 146, 800, 4);\n    franja.setDepth(-39);\n\n    // Logotipos en tarjetas blancas\n    p.rectangulo(-220, 245, 300, 100, c.blanco, { radio: 16, sombra: true, profundidad: 2 });\n    p.imagen(\"logo_unl\", -220, 245, 270);\n    p.rectangulo(175, 245, 330, 80, c.blanco, { radio: 16, sombra: true, profundidad: 2 });\n    p.imagen(\"logo_uedl\", 175, 245, 300);\n\n    p.texto(\"Recurso Educativo Digital\", -40, 175, { ancla: \"centro\", tamano: 18, negrita: true, color: c.amarillo });\n\n    // Logotipo de Word dibujado con figuras\n    p.rectangulo(-300, 95, 76, 76, c.word, { radio: 16, sombra: true });\n    p.rectangulo(-317, 95, 42, 56, \"#1E3F73\", { radio: 6 });\n    p.texto(\"W\", -317, 95, { ancla: \"centro\", tamano: 34, negrita: true, color: c.blanco });\n    p.rectangulo(-281, 107, 22, 4, c.blanco, { radio: 2 });\n    p.rectangulo(-281, 95, 22, 4, c.blanco, { radio: 2 });\n    p.rectangulo(-281, 83, 22, 4, c.blanco, { radio: 2 });\n\n    p.texto(\"Utilizando\\nOffice: Word\", -245, 95, {\n      ancla: \"izquierda\",\n      tamano: 40,\n      negrita: true,\n      color: c.granate,\n      fuente: \"Georgia, 'Times New Roman', serif\",\n      interlineado: -4\n    });\n\n    p.rectangulo(-150, 25, 440, 4, c.rojo_unl, { radio: 2 });\n    p.texto(\"Informática Educativa\", -150, 0, { ancla: \"centro\", tamano: 24, color: c.texto, negrita: true });\n    p.texto(\"Sexto Grado de EGB · Subnivel Medio\\nBloque 3: Ofimática\", -150, -45, { ancla: \"centro\", tamano: 18, color: c.carbon, alinear: \"center\" });\n    p.texto(\"LOJA - ECUADOR\", -150, -105, { ancla: \"centro\", tamano: 20, negrita: true, color: c.granate });\n\n    // Manu con su laptop, pegado al borde derecho de la pantalla\n    p.guia(282, -110, 3.4, \"manu_laptop\");\n    p.globo(\"¡Hola! Soy Manu.\\nVamos a aprender Word.\", 175, 0, 230, { colita: \"derecha\", base: 70 });\n\n    p.boton(\"Comenzar  ▶\", -150, -195, () => {\n      this.pilas.cambiar_escena(\"menu\");\n    }, { ancho: 230, alto: 56, color: c.rojo_unl, tamano: 22 });\n  }\n\n  actualizar() {}\n}\n"
      },
      {
        "nombre": "menu",
        "codigo": "// Escena 2: MENÚ PRINCIPAL\nclass menu extends Escena {\n  iniciar() {\n    let p = this.proyecto;\n    let c = p.colores;\n\n    p.plantilla(\"Menú principal\", {\n      ayuda: \"Haz clic sobre uno de los botones para acceder a cada sección.\"\n    });\n\n    // Cuatro opciones principales, como en un RED\n    let opciones = [\n      { titulo: \"Unidad\\nTemática\", detalle: \"Objetivo, criterio y destrezas\", escena: \"unidad\", color: c.granate, x: -150, y: 110 },\n      { titulo: \"Contenidos\", detalle: \"Aprende las herramientas de Word\", escena: \"contenidos\", color: c.verde, x: 150, y: 110 },\n      { titulo: \"Evaluación\\nCurricular\", detalle: \"Formativa y sumativa\", escena: \"evaluacion\", color: c.naranja, x: -150, y: -60 },\n      { titulo: \"Créditos\", detalle: \"Autor y licencia\", escena: \"creditos\", color: c.carbon, x: 150, y: -60 }\n    ];\n\n    opciones.forEach((opcion) => {\n      p.boton(opcion.titulo, opcion.x, opcion.y + 10, () => {\n        if (opcion.escena === \"contenidos\") {\n          p.pagina_de_contenidos = 0;\n        }\n        this.pilas.cambiar_escena(opcion.escena);\n      }, { ancho: 250, alto: 120, color: opcion.color, tamano: 26 });\n\n      p.texto(opcion.detalle, opcion.x, opcion.y - 72, { ancla: \"centro\", tamano: 15, color: \"#52606D\", cursiva: true });\n    });\n\n    // Botón de inicio y bibliografía\n    p.boton_redondo(\"⌂\", -330, -225, 30, c.granate, () => {\n      this.pilas.cambiar_escena(\"portada\");\n    }, 30);\n    p.texto(\"Inicio\", -330, -268, { ancla: \"centro\", tamano: 13, negrita: true });\n\n    p.boton(\"Bibliografía\", 290, -225, () => {\n      this.pilas.cambiar_escena(\"bibliografia\");\n    }, { ancho: 170, alto: 44, color: c.rojo_unl, tamano: 18 });\n\n    // Manu da la bienvenida ofreciendo la mano\n    p.guia(335, 40, 1.75, \"manu_mano\");\n    p.texto(\"¡Bienvenido!\\nElige tu camino\", 335, -78, { ancla: \"centro\", tamano: 14, negrita: true, color: c.granate, alinear: \"center\" });\n  }\n\n  actualizar() {}\n}\n"
      },
      {
        "nombre": "unidad",
        "codigo": "// Escena 3: UNIDAD TEMÁTICA (datos tomados del currículo)\nclass unidad extends Escena {\n  iniciar() {\n    let p = this.proyecto;\n    let c = p.colores;\n\n    p.plantilla(\"Unidad Temática\", {\n      menu: true,\n      ayuda: \"Aquí encuentras lo que vas a aprender: el objetivo, el criterio de evaluación y las destrezas.\"\n    });\n\n    p.texto(\"BLOQUE 3: OFIMÁTICA  ·  Utilizando Office: Word\", 0, 205, {\n      ancla: \"centro\", tamano: 20, negrita: true, color: c.granate\n    });\n\n    // Objetivo\n    p.rectangulo(-20, 150, 690, 74, c.blanco, { borde: c.borde, radio: 10 });\n    p.texto(\"Objetivo (O.IE.3.3):\", -350, 181, { tamano: 16, negrita: true, color: c.rojo });\n    p.texto(\"Utilizar Word, Excel y Power Point para la elaboración de documentos, operaciones matemáticas y presentaciones, necesarios para la exposición y presentación de sus tareas y vida cotidiana.\", -350, 161, {\n      tamano: 14, ancho: 660\n    });\n\n    // Criterios de evaluación\n    p.rectangulo(-20, 61, 690, 92, c.blanco, { borde: c.borde, radio: 10 });\n    p.texto(\"Criterios de evaluación:\", -350, 101, { tamano: 16, negrita: true, color: c.rojo });\n    p.texto(\"CE.IE.3.3. Aplica las diferentes opciones existentes en la interfaz de Word (barra de herramientas, de título, cinta de opciones, botones), en la elaboración de textos.\\nCE.IE.3.4. Aplica elementos de texto artístico (WordArt, cuadro de texto, autoformas, letra capital, viñetas, tablas) para la elaboración de documentos.\", -350, 81, {\n      tamano: 13, ancho: 660, interlineado: 2\n    });\n\n    // Destrezas\n    p.rectangulo(-20, -109, 690, 230, c.blanco, { borde: c.borde, radio: 10 });\n    p.texto(\"Destrezas con criterios de desempeño:\", -350, 2, { tamano: 16, negrita: true, color: c.rojo });\n\n    let destrezas = [\n      \"IE.3.3.1. Reconocer los elementos de la interfaz de Word.\",\n      \"IE.3.3.2. Aplicar formato al texto (tamaño, tipo, color).\",\n      \"IE.3.3.3. Insertar caracteres especiales, mayúsculas/minúsculas, autoformas, viñetas y WordArt.\",\n      \"IE.3.3.4. Copiar, cortar y pegar texto.\",\n      \"IE.3.3.5. Insertar encabezados y pie de página.\",\n      \"IE.3.3.6. Insertar letra capital.\",\n      \"IE.3.3.7. Insertar tablas en el documento.\",\n      \"IE.3.3.8. Insertar columnas de texto.\",\n      \"IE.3.3.9. Guardar e insertar imágenes desde archivo.\",\n      \"IE.3.3.10. Insertar imágenes de fondo y marca de agua.\",\n      \"IE.3.3.11. Guardar un documento en PDF.\"\n    ];\n\n    p.texto(destrezas.join(\"\\n\"), -350, -19, { tamano: 13, ancho: 650, interlineado: 1 });\n  }\n\n  actualizar() {}\n}\n"
      },
      {
        "nombre": "contenidos",
        "codigo": "// Escena 4: CONTENIDOS\n// Cada página es un método (pagina_1, pagina_2, ...). La página actual\n// se guarda en el proyecto para que no se pierda al reiniciar la escena.\nclass contenidos extends Escena {\n  total_de_paginas = 8;\n\n  iniciar() {\n    let p = this.proyecto;\n    let c = p.colores;\n    let numero = p.pagina_de_contenidos + 1;\n\n    p.plantilla(\"Contenidos\", {\n      menu: true,\n      ayuda: \"Lee cada página y usa los botones Anterior y Siguiente. En algunas páginas puedes hacer clic para practicar.\"\n    });\n\n    // Llama al método de la página actual: pagina_1(), pagina_2(), ...\n    this[\"pagina_\" + numero](p, c);\n\n    // Navegación\n    if (numero > 1) {\n      p.boton(\"◀  Anterior\", -230, -240, () => this.ir_a_pagina(p.pagina_de_contenidos - 1), { ancho: 150, alto: 40, tamano: 16, color: c.rojo_unl });\n    }\n\n    p.texto(numero + \" / \" + this.total_de_paginas, -40, -240, { ancla: \"centro\", tamano: 18, negrita: true, color: c.granate });\n\n    if (numero < this.total_de_paginas) {\n      p.boton(\"Siguiente  ▶\", 150, -240, () => this.ir_a_pagina(p.pagina_de_contenidos + 1), { ancho: 150, alto: 40, tamano: 16, color: c.rojo_unl });\n    } else {\n      p.boton(\"Evaluación  ▶\", 150, -240, () => this.pilas.cambiar_escena(\"evaluacion\"), { ancho: 170, alto: 40, tamano: 16, color: c.verde });\n    }\n  }\n\n  ir_a_pagina(indice: number) {\n    this.proyecto.pagina_de_contenidos = indice;\n    this.pilas.reiniciar_escena();\n  }\n\n  subtitulo(texto: string, destreza: string) {\n    let p = this.proyecto;\n    p.texto(texto, -350, 226, { tamano: 20, negrita: true, color: p.colores.granate });\n    p.texto(destreza, 360, 224, { ancla: \"derecha\", tamano: 12, color: \"#6B7785\", cursiva: true });\n  }\n\n  // -------------------------------------------------------------------\n  // Página 1: La interfaz de Word (diagrama interactivo)\n  // -------------------------------------------------------------------\n  pagina_1(p, c) {\n    this.subtitulo(\"1. La interfaz de Word\", \"Destreza IE.3.3.1\");\n\n    // Ventana de Word dibujada\n    let x = -115;\n    p.rectangulo(x, -10, 470, 400, \"#E7EAEE\", { radio: 6, sombra: true, borde: \"#9AA5B1\" });\n    p.rectangulo(x, 177, 470, 26, c.word, { radio: 4 });\n    p.texto(\"Documento1 - Word\", x, 177, { ancla: \"centro\", tamano: 12, color: c.blanco });\n    for (let i = 0; i < 3; i++) {\n      p.rectangulo(x - 220 + i * 18, 177, 12, 12, \"#9DB9E3\", { radio: 2 });\n    }\n    p.rectangulo(x, 153, 470, 22, c.word, { radio: 0 });\n    p.texto(\"Archivo   Inicio   Insertar   Diseño   Disposición   Referencias   Vista\", x - 222, 161, { tamano: 12, color: c.blanco });\n    p.rectangulo(x, 115, 466, 50, \"#F7F8FA\", { radio: 0, borde: \"#C9D1DC\", grosor: 1 });\n    let grupos = [\"Portapapeles\", \"Fuente\", \"Párrafo\", \"Estilos\"];\n    for (let i = 0; i < grupos.length; i++) {\n      let gx = x - 175 + i * 116;\n      p.rectangulo(gx, 120, 104, 26, \"#E1E7EF\", { radio: 4 });\n      p.texto(i === 1 ? \"N  K  S  A\" : \"▤ ▥ ▦\", gx, 120, { ancla: \"centro\", tamano: 12, negrita: true, color: \"#1E3F73\" });\n      p.texto(grupos[i], gx, 99, { ancla: \"centro\", tamano: 9, color: \"#52606D\" });\n    }\n    p.rectangulo(x, 81, 440, 12, c.blanco, { radio: 0, borde: \"#C9D1DC\", grosor: 1 });\n    for (let i = 0; i < 22; i++) {\n      p.linea(x - 210 + i * 20, 85, x - 210 + i * 20, 79, \"#9AA5B1\", 1);\n    }\n    p.rectangulo(x, -60, 270, 262, c.blanco, { radio: 0, borde: \"#C9D1DC\", grosor: 1 });\n    p.texto(\"Mi primer documento\", x, 50, { ancla: \"centro\", tamano: 14, negrita: true, color: c.word });\n    for (let i = 0; i < 9; i++) {\n      p.rectangulo(x - (i % 3) * 8, 25 - i * 20, 210 - (i % 3) * 16, 6, \"#CBD2D9\", { radio: 3 });\n    }\n    p.rectangulo(x, -198, 470, 22, c.word, { radio: 4 });\n    p.texto(\"Página 1 de 1   45 palabras\", x - 225, -192, { tamano: 11, color: c.blanco });\n    p.texto(\"—●—  100 %\", x + 225, -192, { ancla: \"derecha\", tamano: 11, color: c.blanco });\n\n    // Partes con su número y explicación\n    let partes = [\n      { n: \"1\", x: x + 120, y: 177, titulo: \"Barra de título\", texto: \"Muestra el nombre del documento y del programa. Aquí están los botones minimizar, maximizar y cerrar.\" },\n      { n: \"2\", x: x - 165, y: 177, titulo: \"Barra de acceso rápido\", texto: \"Tiene los botones que más usamos: Guardar, Deshacer y Rehacer.\" },\n      { n: \"3\", x: x + 235, y: 153, titulo: \"Pestañas\", texto: \"Archivo, Inicio, Insertar, Diseño, Disposición... Cada pestaña muestra un grupo distinto de herramientas.\" },\n      { n: \"4\", x: x + 235, y: 115, titulo: \"Cinta de opciones\", texto: \"Contiene los botones organizados en grupos: Portapapeles, Fuente, Párrafo y Estilos.\" },\n      { n: \"5\", x: x + 235, y: 81, titulo: \"Regla\", texto: \"Sirve para medir y ajustar los márgenes y las sangrías del texto.\" },\n      { n: \"6\", x: x + 160, y: -40, titulo: \"Área de trabajo\", texto: \"Es la hoja en blanco donde escribimos el documento. El cursor parpadeante indica dónde aparecerá el texto.\" },\n      { n: \"7\", x: x - 40, y: -198, titulo: \"Barra de estado\", texto: \"Indica la página en la que estamos, el número de palabras y el idioma.\" },\n      { n: \"8\", x: x + 150, y: -198, titulo: \"Zoom\", texto: \"Permite acercar o alejar la vista del documento sin cambiar el tamaño real de la letra.\" }\n    ];\n\n    p.rectangulo(275, -10, 210, 330, c.blanco, { borde: c.granate, grosor: 2, radio: 12, sombra: true });\n    let titulo = p.texto(\"Haz clic en cada número\", 275, 135, { ancla: \"arriba\", tamano: 17, negrita: true, color: c.rojo, ancho: 190, alinear: \"center\" });\n    let detalle = p.texto(\"Descubre para qué sirve cada parte de la ventana de Word.\", 275, 85, { ancla: \"arriba\", tamano: 15, ancho: 185, alinear: \"center\" });\n\n    partes.forEach((parte) => {\n      p.boton_redondo(parte.n, parte.x, parte.y, 13, c.naranja, () => {\n        titulo.setText(parte.n + \". \" + parte.titulo);\n        detalle.setText(parte.texto);\n      }, 14);\n    });\n  }\n\n  // -------------------------------------------------------------------\n  // Página 2: Formato de texto (con práctica interactiva)\n  // -------------------------------------------------------------------\n  pagina_2(p, c) {\n    this.subtitulo(\"2. Formato al texto: tipo, tamaño y color\", \"Destreza IE.3.3.2\");\n\n    p.rectangulo(-195, 15, 330, 360, c.blanco, { borde: c.borde, radio: 12 });\n    p.texto(\"Pestaña Inicio  ▸  grupo Fuente\", -345, 180, { tamano: 15, negrita: true, color: c.rojo });\n    p.texto(\n      \"1. Selecciona el texto (arrastra el mouse sobre él).\\n\" +\n      \"2. Elige el tipo de letra: Arial, Calibri, Times New Roman...\\n\" +\n      \"3. Elige el tamaño: 8, 12, 18, 28...\\n\" +\n      \"4. Cambia el color con el botón  A.\\n\\n\" +\n      \"Atajos del teclado (Word en español):\\n\" +\n      \"   Ctrl + N  →  Negrita\\n\" +\n      \"   Ctrl + K  →  Cursiva\\n\" +\n      \"   Ctrl + S  →  Subrayado\",\n      -345, 150, { tamano: 15, ancho: 300, interlineado: 6 }\n    );\n\n    // Práctica: el texto cambia con los botones\n    p.rectangulo(175, 15, 360, 360, c.rosa_claro, { borde: c.granate, radio: 12 });\n    p.texto(\"¡Practica aquí!\", 175, 180, { ancla: \"centro\", tamano: 18, negrita: true, color: c.granate });\n    p.rectangulo(175, 100, 320, 100, c.blanco, { radio: 6, borde: c.borde });\n\n    let estado = { negrita: false, cursiva: false, subrayado: false, tamano: 26, color: c.texto, fuente: 0 };\n    let fuentes = [\"Arial\", \"Times New Roman\", \"Courier New\", \"Comic Sans MS\"];\n    let muestra = p.texto(\"Escuela de Loja\", 175, 100, { ancla: \"centro\", tamano: 26, profundidad: 12 });\n    let subrayado = p.linea(0, 0, 0, 0, c.texto, 2, 12);\n    let nombre_fuente = p.texto(\"Fuente: Arial  ·  Tamaño: 26\", 175, 37, { ancla: \"centro\", tamano: 13, color: \"#52606D\" });\n\n    let actualizar = () => {\n      let estilo = (estado.negrita ? \"bold \" : \"\") + (estado.cursiva ? \"italic\" : \"\");\n      muestra.setFontStyle(estilo.trim() || \"normal\");\n      muestra.setFontSize(estado.tamano + \"px\");\n      muestra.setFontFamily(fuentes[estado.fuente]);\n      muestra.setColor(estado.color);\n      nombre_fuente.setText(\"Fuente: \" + fuentes[estado.fuente] + \"  ·  Tamaño: \" + estado.tamano);\n      subrayado.clear();\n      if (estado.subrayado) {\n        subrayado.lineStyle(2, p.color_numerico(estado.color), 1);\n        subrayado.lineBetween(muestra.x - muestra.width / 2, muestra.y + muestra.height / 2, muestra.x + muestra.width / 2, muestra.y + muestra.height / 2);\n      }\n    };\n\n    let opciones = { ancho: 52, alto: 42, tamano: 20, color: c.blanco, color_del_texto: c.granate_oscuro, borde: c.granate };\n    p.boton(\"N\", 55, -10, () => { estado.negrita = !estado.negrita; actualizar(); }, opciones);\n    p.boton(\"K\", 115, -10, () => { estado.cursiva = !estado.cursiva; actualizar(); }, opciones);\n    p.boton(\"S\", 175, -10, () => { estado.subrayado = !estado.subrayado; actualizar(); }, opciones);\n    p.boton(\"A+\", 235, -10, () => { estado.tamano = Math.min(40, estado.tamano + 2); actualizar(); }, opciones);\n    p.boton(\"A-\", 295, -10, () => { estado.tamano = Math.max(14, estado.tamano - 2); actualizar(); }, opciones);\n\n    let colores = [c.texto, c.rojo, c.verde, c.granate, c.carbon];\n    colores.forEach((color, i) => {\n      p.boton(\"A\", 55 + i * 60, -65, () => { estado.color = color; actualizar(); }, { ancho: 46, alto: 38, tamano: 18, color: color });\n    });\n\n    p.boton(\"Cambiar fuente\", 175, -120, () => {\n      estado.fuente = (estado.fuente + 1) % fuentes.length;\n      actualizar();\n    }, { ancho: 200, alto: 40, tamano: 16, color: c.naranja });\n  }\n\n  // -------------------------------------------------------------------\n  // Página 3: Caracteres especiales, mayúsculas, viñetas, formas y WordArt\n  // -------------------------------------------------------------------\n  pagina_3(p, c) {\n    this.subtitulo(\"3. Símbolos, mayúsculas, viñetas, formas y WordArt\", \"Destreza IE.3.3.3\");\n\n    let tarjetas = [\n      { x: -235, y: 100, titulo: \"Caracteres especiales\", ruta: \"Insertar ▸ Símbolo\", ejemplo: \"©  ®  ñ  €  ½  ¿  ¡  ♥\" },\n      { x: 0, y: 100, titulo: \"Mayúsculas y minúsculas\", ruta: \"Inicio ▸ Aa  (Shift + F3)\", ejemplo: \"hola  →  HOLA  →  Hola\" },\n      { x: 235, y: 100, titulo: \"Viñetas y numeración\", ruta: \"Inicio ▸ Viñetas / Numeración\", ejemplo: \"•  Lápiz\\n•  Cuaderno\\n1.  Leer   2.  Escribir\" },\n      { x: -120, y: -100, titulo: \"Autoformas\", ruta: \"Insertar ▸ Formas\", ejemplo: \"\" },\n      { x: 120, y: -100, titulo: \"Texto artístico (WordArt)\", ruta: \"Insertar ▸ WordArt\", ejemplo: \"\" }\n    ];\n\n    tarjetas.forEach((t) => {\n      p.rectangulo(t.x, t.y, 220, 175, c.blanco, { borde: c.borde, radio: 12, sombra: true });\n      p.rectangulo(t.x, t.y + 70, 220, 36, c.granate, { radio: 12 });\n      p.texto(t.titulo, t.x, t.y + 70, { ancla: \"centro\", tamano: 15, negrita: true, color: c.blanco, ancho: 210, alinear: \"center\" });\n      p.texto(t.ruta, t.x, t.y + 38, { ancla: \"centro\", tamano: 13, negrita: true, color: c.rojo, ancho: 205, alinear: \"center\" });\n      if (t.ejemplo) {\n        p.texto(t.ejemplo, t.x, t.y - 20, { ancla: \"centro\", tamano: 18, alinear: \"center\", ancho: 205 });\n      }\n    });\n\n    // Autoformas dibujadas\n    p.rectangulo(-185, -130, 50, 40, c.rojo_unl, { radio: 0 });\n    p.circulo(-120, -130, 22, c.verde);\n    p.rectangulo(-55, -130, 50, 40, c.naranja, { radio: 18 });\n    p.texto(\"★\", -120, -87, { ancla: \"centro\", tamano: 26, color: c.naranja });\n\n    // WordArt: texto con borde y sombra\n    let wordart = p.texto(\"¡Word!\", 120, -123, {\n      ancla: \"centro\", tamano: 46, negrita: true, cursiva: true, color: \"#FFD43B\",\n      fuente: \"Georgia, serif\", profundidad: 12\n    });\n    wordart.setStroke(\"#C2410C\", 6);\n    wordart.setShadow(4, 4, \"#00000066\", 4, true, true);\n  }\n\n  // -------------------------------------------------------------------\n  // Página 4: Copiar, cortar y pegar (con práctica)\n  // -------------------------------------------------------------------\n  pagina_4(p, c) {\n    this.subtitulo(\"4. Copiar, cortar y pegar\", \"Destreza IE.3.3.4\");\n\n    let comandos = [\n      { teclas: \"Ctrl + C\", nombre: \"Copiar\", texto: \"Duplica el texto seleccionado. El original se queda donde estaba.\", color: c.granate },\n      { teclas: \"Ctrl + X\", nombre: \"Cortar\", texto: \"Quita el texto seleccionado para moverlo a otro lugar.\", color: c.rojo },\n      { teclas: \"Ctrl + V\", nombre: \"Pegar\", texto: \"Coloca lo que copiaste o cortaste donde está el cursor.\", color: c.verde }\n    ];\n\n    comandos.forEach((cmd, i) => {\n      let y = 150 - i * 92;\n      p.rectangulo(-200, y, 320, 80, c.blanco, { borde: c.borde, radio: 12 });\n      p.rectangulo(-305, y, 92, 56, cmd.color, { radio: 10 });\n      p.texto(cmd.teclas, -305, y, { ancla: \"centro\", tamano: 16, negrita: true, color: c.blanco });\n      p.texto(cmd.nombre, -248, y + 28, { tamano: 17, negrita: true, color: cmd.color });\n      p.texto(cmd.texto, -248, y + 6, { tamano: 13, ancho: 200 });\n    });\n\n    p.texto(\"Los encuentras en: Inicio ▸ Portapapeles\", -200, -130, { ancla: \"centro\", tamano: 14, negrita: true, color: c.rojo });\n\n    // Práctica: mover o duplicar una palabra entre dos párrafos\n    p.rectangulo(190, 15, 330, 360, c.rosa_claro, { borde: c.granate, radio: 12 });\n    p.texto(\"¡Practica aquí!\", 190, 180, { ancla: \"centro\", tamano: 18, negrita: true, color: c.granate });\n    p.texto(\"Párrafo A\", 70, 150, { tamano: 14, negrita: true });\n    p.rectangulo(190, 108, 290, 48, c.blanco, { radio: 6, borde: c.borde });\n    p.texto(\"Párrafo B\", 70, 70, { tamano: 14, negrita: true });\n    p.rectangulo(190, 28, 290, 48, c.blanco, { radio: 6, borde: c.borde });\n\n    let estado = { en_a: true, en_b: 0, portapapeles: \"\" };\n    let texto_a = p.texto(\"\", 190, 108, { ancla: \"centro\", tamano: 18, profundidad: 12 });\n    let texto_b = p.texto(\"\", 190, 28, { ancla: \"centro\", tamano: 18, profundidad: 12 });\n    let mensaje = p.texto(\"Primero elige Copiar o Cortar.\", 190, -150, { ancla: \"centro\", tamano: 14, cursiva: true, ancho: 300, alinear: \"center\" });\n\n    let mostrar = () => {\n      texto_a.setText(\"Me gusta \" + (estado.en_a ? \"LOJA\" : \"____\"));\n      let pegados = \"\";\n      for (let i = 0; i < estado.en_b; i++) {\n        pegados += \" LOJA\";\n      }\n      texto_b.setText(\"Visita\" + pegados);\n    };\n\n    p.boton(\"Copiar\", 100, -40, () => {\n      if (estado.en_a) {\n        estado.portapapeles = \"copiado\";\n        mensaje.setText(\"Copiaste la palabra LOJA. Ahora pulsa Pegar.\");\n      }\n    }, { ancho: 120, alto: 42, color: c.granate, tamano: 16 });\n\n    p.boton(\"Cortar\", 240, -40, () => {\n      if (estado.en_a) {\n        estado.en_a = false;\n        estado.portapapeles = \"cortado\";\n        mensaje.setText(\"Cortaste LOJA: desapareció del párrafo A. Ahora pulsa Pegar.\");\n        mostrar();\n      }\n    }, { ancho: 120, alto: 42, color: c.rojo, tamano: 16 });\n\n    p.boton(\"Pegar\", 100, -95, () => {\n      if (estado.portapapeles && estado.en_b < 2) {\n        estado.en_b += 1;\n        mensaje.setText(estado.portapapeles === \"copiado\" ? \"¡Muy bien! Copiar deja el original y crea un duplicado.\" : \"¡Muy bien! Cortar y pegar MUEVE el texto.\");\n        mostrar();\n      }\n    }, { ancho: 120, alto: 42, color: c.verde, tamano: 16 });\n\n    p.boton(\"Reiniciar\", 240, -95, () => {\n      estado.en_a = true;\n      estado.en_b = 0;\n      estado.portapapeles = \"\";\n      mensaje.setText(\"Primero elige Copiar o Cortar.\");\n      mostrar();\n    }, { ancho: 120, alto: 42, color: \"#6B7785\", tamano: 16 });\n\n    mostrar();\n  }\n\n  // -------------------------------------------------------------------\n  // Página 5: Encabezado, pie de página y letra capital\n  // -------------------------------------------------------------------\n  pagina_5(p, c) {\n    this.subtitulo(\"5. Encabezado, pie de página y letra capital\", \"Destrezas IE.3.3.5 y IE.3.3.6\");\n\n    // Hoja de ejemplo\n    let hx = 170;\n    p.rectangulo(hx, -5, 300, 400, c.blanco, { borde: \"#9AA5B1\", radio: 4, sombra: true });\n    p.rectangulo(hx, 165, 280, 38, \"#FFF4E5\", { radio: 4, borde: c.naranja });\n    p.texto(\"Escuela Municipal  ·  6.º grado\", hx, 165, { ancla: \"centro\", tamano: 13, color: \"#9A3412\" });\n    p.rectangulo(hx, -175, 280, 38, \"#FFF4E5\", { radio: 4, borde: c.naranja });\n    p.texto(\"Página 1\", hx, -175, { ancla: \"centro\", tamano: 13, color: \"#9A3412\" });\n\n    p.texto(\"E\", hx - 128, 125, { tamano: 64, negrita: true, color: c.granate, fuente: \"Georgia, serif\" });\n    p.texto(\"n Loja hay hermosos\\nparques, ríos y\\nmontañas que\", hx - 75, 125, { tamano: 14, interlineado: 3 });\n    p.texto(\"visitamos con nuestra familia los fines de semana. La ciudad es conocida como la cuna de la música del Ecuador.\", hx - 128, 62, { tamano: 14, ancho: 256, interlineado: 3 });\n    for (let i = 0; i < 6; i++) {\n      p.rectangulo(hx, -35 - i * 18, 256, 6, \"#CBD2D9\", { radio: 3 });\n    }\n\n    // Etiquetas\n    p.texto(\"Encabezado ▸\", hx - 160, 165, { ancla: \"derecha\", tamano: 13, negrita: true, color: c.naranja });\n    p.texto(\"Letra capital ▸\", hx - 160, 108, { ancla: \"derecha\", tamano: 13, negrita: true, color: c.granate });\n    p.texto(\"Pie de página ▸\", hx - 160, -183, { ancla: \"derecha\", tamano: 13, negrita: true, color: c.naranja });\n\n    // Explicación\n    p.texto(\n      \"ENCABEZADO: texto que se repite en la parte superior de todas las páginas (nombre de la escuela, título).\\n\\n\" +\n      \"PIE DE PÁGINA: texto que se repite en la parte inferior (número de página, fecha).\\n\" +\n      \"   Insertar ▸ Encabezado / Pie de página\\n\\n\" +\n      \"LETRA CAPITAL: primera letra grande de un párrafo, como en los cuentos.\\n\" +\n      \"   Insertar ▸ Letra capital ▸ En texto\",\n      -350, 120, { tamano: 14, ancho: 250, interlineado: 4 }\n    );\n  }\n\n  // -------------------------------------------------------------------\n  // Página 6: Tablas y columnas\n  // -------------------------------------------------------------------\n  pagina_6(p, c) {\n    this.subtitulo(\"6. Tablas y columnas de texto\", \"Destrezas IE.3.3.7 y IE.3.3.8\");\n\n    // Tabla\n    p.texto(\"TABLAS:  Insertar ▸ Tabla\", -350, 180, { tamano: 16, negrita: true, color: c.rojo });\n    p.texto(\"Elige cuántas columnas y filas necesitas. Sirven para ordenar datos.\", -350, 155, { tamano: 14, ancho: 330 });\n\n    let datos = [[\"Nombre\", \"Materia\", \"Nota\"], [\"Ana\", \"Lengua\", \"9\"], [\"Luis\", \"Matemática\", \"10\"], [\"Sofía\", \"Ciencias\", \"8\"]];\n    for (let fila = 0; fila < datos.length; fila++) {\n      for (let col = 0; col < 3; col++) {\n        let x = -290 + col * 110;\n        let y = 95 - fila * 40;\n        p.rectangulo(x, y, 110, 40, fila === 0 ? c.granate : (fila % 2 ? c.blanco : c.rosa_claro), { radio: 0, borde: c.granate, grosor: 1 });\n        p.texto(datos[fila][col], x, y, { ancla: \"centro\", tamano: 15, negrita: fila === 0, color: fila === 0 ? c.blanco : c.texto });\n      }\n    }\n    p.texto(\"↑ columna\", -180, -62, { ancla: \"centro\", tamano: 13, cursiva: true, color: c.naranja });\n    p.texto(\"← fila\", -8, 63, { tamano: 13, cursiva: true, color: c.naranja });\n\n    // Columnas\n    p.texto(\"COLUMNAS:  Disposición ▸ Columnas\", 30, 180, { tamano: 16, negrita: true, color: c.rojo });\n    p.texto(\"Dividen el texto como en un periódico.\", 30, 155, { tamano: 14, ancho: 330 });\n    p.rectangulo(200, -10, 330, 260, c.blanco, { borde: \"#9AA5B1\", radio: 4, sombra: true });\n    p.texto(\"EL PERIÓDICO ESCOLAR\", 200, 100, { ancla: \"centro\", tamano: 16, negrita: true, color: c.granate, fuente: \"Georgia, serif\" });\n    p.texto(\"Los estudiantes de sexto grado aprendieron a usar Word para escribir sus tareas y noticias.\", 52, 75, { tamano: 13, ancho: 140, interlineado: 2 });\n    p.texto(\"También aprendieron a insertar tablas, imágenes y a guardar sus trabajos en PDF.\", 210, 75, { tamano: 13, ancho: 140, interlineado: 2 });\n    p.linea(200, 78, 200, -120, c.borde, 1, 3);\n\n    p.texto(\"Consejo: en una tabla usa la tecla Tab para pasar a la siguiente celda.\", -350, -125, { tamano: 14, cursiva: true, color: c.verde, ancho: 330 });\n  }\n\n  // -------------------------------------------------------------------\n  // Página 7: Imágenes, color de página y marca de agua\n  // -------------------------------------------------------------------\n  pagina_7(p, c) {\n    this.subtitulo(\"7. Imágenes, fondo de página y marca de agua\", \"Destrezas IE.3.3.9 y IE.3.3.10\");\n\n    p.texto(\n      \"INSERTAR UNA IMAGEN DESDE ARCHIVO:\\n   Insertar ▸ Imágenes ▸ Este dispositivo\\n   Busca la imagen en tu carpeta y pulsa Insertar.\\n\\n\" +\n      \"GUARDAR UNA IMAGEN DEL DOCUMENTO:\\n   Clic derecho sobre la imagen ▸ Guardar como imagen.\\n\\n\" +\n      \"COLOR O IMAGEN DE FONDO:\\n   Diseño ▸ Color de página\\n   (Efectos de relleno ▸ Imagen, para usar una foto).\\n\\n\" +\n      \"MARCA DE AGUA:\\n   Diseño ▸ Marca de agua\\n   Es un texto o imagen clarito que aparece detrás del contenido, por ejemplo: BORRADOR o CONFIDENCIAL.\",\n      -350, 185, { tamano: 14, ancho: 360, interlineado: 3 }\n    );\n\n    // Hoja con fondo de color, imagen y marca de agua\n    let hx = 210;\n    p.rectangulo(hx, -5, 290, 390, \"#FFF8E1\", { borde: \"#9AA5B1\", radio: 4, sombra: true });\n    let marca = p.texto(\"BORRADOR\", hx, -30, { ancla: \"centro\", tamano: 48, negrita: true, color: \"#9AA5B1\", profundidad: 2 });\n    marca.setRotation(-0.75);\n    marca.setAlpha(0.35);\n\n    p.texto(\"Mi mascota\", hx, 160, { ancla: \"centro\", tamano: 18, negrita: true, color: c.granate });\n    // \"imagen\" insertada: un actor de pilas\n    p.rectangulo(hx, 85, 130, 105, c.blanco, { borde: c.borde, radio: 4, profundidad: 3 });\n    let imagen = this.pilas.actores.actor_basico(\"imagenes:conejo/conejo_parado1\");\n    imagen.x = hx;\n    imagen.y = 85;\n    imagen.escala = 0.8;\n    imagen.z = -5;\n    for (let i = 0; i < 8; i++) {\n      p.rectangulo(hx, 10 - i * 20, 230 - (i % 2) * 30, 6, \"#CBD2D9\", { radio: 3, profundidad: 3 });\n    }\n  }\n\n  // -------------------------------------------------------------------\n  // Página 8: Guardar en PDF\n  // -------------------------------------------------------------------\n  pagina_8(p, c) {\n    this.subtitulo(\"8. Guardar un documento en PDF\", \"Destreza IE.3.3.11\");\n\n    let pasos = [\n      \"Haz clic en la pestaña Archivo.\",\n      \"Elige Guardar como (o pulsa F12).\",\n      \"Selecciona la carpeta donde lo guardarás.\",\n      \"En Tipo, elige  PDF (*.pdf).\",\n      \"Escribe el nombre y pulsa Guardar.\"\n    ];\n\n    pasos.forEach((paso, i) => {\n      let y = 160 - i * 58;\n      p.circulo(-325, y, 20, c.naranja);\n      p.texto(String(i + 1), -325, y, { ancla: \"centro\", tamano: 18, negrita: true, color: c.blanco });\n      p.texto(paso, -295, y + 10, { tamano: 16, ancho: 290 });\n    });\n\n    p.texto(\"¿Por qué PDF? Se ve igual en cualquier computadora o celular y es más difícil de modificar. ¡Ideal para entregar tareas!\", -350, -135, {\n      tamano: 14, cursiva: true, color: c.verde, ancho: 380\n    });\n\n    // Ventana \"Guardar como\"\n    p.rectangulo(200, 20, 320, 260, c.blanco, { borde: \"#9AA5B1\", radio: 6, sombra: true });\n    p.rectangulo(200, 137, 320, 26, c.granate, { radio: 6 });\n    p.texto(\"Guardar como\", 50, 145, { tamano: 13, negrita: true, color: c.blanco });\n    p.texto(\"📁 Documentos ▸ Tareas\", 55, 105, { tamano: 13, color: c.texto });\n    p.texto(\"Nombre:\", 55, 65, { tamano: 13, negrita: true });\n    p.rectangulo(240, 58, 200, 26, c.crema, { borde: c.borde, radio: 3 });\n    p.texto(\"Mi tarea de Word\", 148, 65, { tamano: 13 });\n    p.texto(\"Tipo:\", 55, 25, { tamano: 13, negrita: true });\n    p.rectangulo(240, 18, 200, 26, \"#FFF4E5\", { borde: c.naranja, grosor: 2, radio: 3 });\n    p.texto(\"PDF (*.pdf)          ▾\", 148, 25, { tamano: 13, negrita: true, color: \"#9A3412\" });\n    p.boton(\"Guardar\", 290, -60, () => {\n      p.globo(\"¡Listo! Tu documento se guardó como PDF.\", 200, -140, 300, { colita: \"derecha\" });\n    }, { ancho: 110, alto: 36, tamano: 15, color: c.granate });\n  }\n\n  actualizar() {}\n}\n"
      },
      {
        "nombre": "evaluacion",
        "codigo": "// Escena 5: EVALUACIÓN CURRICULAR (elegir formativa o sumativa)\nclass evaluacion extends Escena {\n  iniciar() {\n    let p = this.proyecto;\n    let c = p.colores;\n\n    p.plantilla(\"Evaluación Curricular\", {\n      menu: true,\n      ayuda: \"La evaluación formativa es para practicar: puedes intentar varias veces. La sumativa tiene 10 preguntas y te da una calificación.\"\n    });\n\n    let tipos = [\n      { titulo: \"Evaluación\\nformativa\", detalle: \"Practica con actividades y una sopa de letras. Puedes intentar las veces que necesites.\", x: -175, color: c.verde, escena: \"formativa\" },\n      { titulo: \"Evaluación\\nsumativa\", detalle: \"10 preguntas. Cada respuesta correcta vale 1 punto. ¡Lee con atención!\", x: 175, color: c.carbon, escena: \"sumativa\" }\n    ];\n\n    tipos.forEach((tipo) => {\n      p.circulo(tipo.x, 60, 118, c.blanco, { borde: tipo.color, grosor: 8, sombra: true });\n      p.texto(\"❝\", tipo.x - 95, 150, { ancla: \"centro\", tamano: 54, color: tipo.color });\n      p.texto(\"❞\", tipo.x + 95, -30, { ancla: \"centro\", tamano: 54, color: tipo.color });\n      p.boton(tipo.titulo, tipo.x, 60, () => {\n        p.reiniciar_evaluaciones();\n        this.pilas.cambiar_escena(tipo.escena);\n      }, { ancho: 180, alto: 180, radio: 90, color: tipo.color, tamano: 24 });\n      p.texto(tipo.detalle, tipo.x, -95, { ancla: \"arriba\", tamano: 15, ancho: 280, alinear: \"center\", color: \"#52606D\" });\n    });\n  }\n\n  actualizar() {}\n}\n"
      },
      {
        "nombre": "formativa",
        "codigo": "// Escena 6: EVALUACIÓN FORMATIVA\n// El estudiante puede equivocarse e intentar otra vez. El personaje\n// guía le da retroalimentación en cada intento.\nclass formativa extends Escena {\n  campo: any = null;\n  guia: any = null;\n  globo: any = null;\n  resuelta = false;\n\n  actividades = [\n    {\n      tipo: \"verdadero_falso\",\n      consigna: \"Selecciona la respuesta correcta\",\n      enunciado: \"La cinta de opciones de Word está formada por pestañas como Inicio, Insertar y Diseño.\",\n      correcta: \"Verdadero\",\n      explicacion: \"Cada pestaña muestra un grupo diferente de herramientas.\"\n    },\n    {\n      tipo: \"opcion_multiple\",\n      consigna: \"Selecciona la respuesta correcta\",\n      enunciado: \"¿Qué combinación de teclas sirve para COPIAR un texto?\",\n      opciones: [\"Ctrl + C\", \"Ctrl + V\", \"Ctrl + X\"],\n      correcta: \"Ctrl + C\",\n      explicacion: \"Ctrl + V es Pegar y Ctrl + X es Cortar.\"\n    },\n    {\n      tipo: \"verdadero_falso\",\n      consigna: \"Selecciona la respuesta correcta\",\n      enunciado: \"La letra capital es una letra pequeña que se coloca al final de un párrafo.\",\n      correcta: \"Falso\",\n      explicacion: \"La letra capital es la primera letra del párrafo, en tamaño grande.\"\n    },\n    {\n      tipo: \"escribir\",\n      consigna: \"Escribe la respuesta correcta\",\n      enunciado: \"Escribe la extensión (3 letras) del formato que usamos para compartir un documento sin que se modifique fácilmente.\",\n      aceptadas: [\"pdf\", \".pdf\"],\n      explicacion: \"Archivo ▸ Guardar como ▸ Tipo: PDF.\"\n    },\n    {\n      tipo: \"opcion_multiple\",\n      consigna: \"Selecciona la respuesta correcta\",\n      enunciado: \"Para insertar una tabla en el documento vamos a la pestaña:\",\n      opciones: [\"Insertar\", \"Inicio\", \"Vista\"],\n      correcta: \"Insertar\",\n      explicacion: \"Insertar ▸ Tabla, y eliges las filas y columnas.\"\n    }\n  ];\n\n  iniciar() {\n    let p = this.proyecto;\n    let c = p.colores;\n    let indice = p.actividad_formativa;\n    let actividad = this.actividades[indice];\n    let total = this.actividades.length + 1; // +1 por la sopa de letras\n\n    p.plantilla(\"Evaluación formativa\", {\n      menu: true,\n      ayuda: \"Lee la pregunta y elige o escribe la respuesta. Si te equivocas, ¡puedes intentarlo otra vez!\"\n    });\n    p.texto(\"Actividad \" + (indice + 1) + \" de \" + total, 318, 265, { ancla: \"derecha\", tamano: 15, color: c.rosa_claro, negrita: true });\n\n    // Barra de progreso con puntos\n    for (let i = 0; i < total; i++) {\n      p.circulo(-((total - 1) * 22) / 2 + i * 22, 210, 7, i <= indice ? c.naranja : c.borde);\n    }\n\n    this.guia = p.guia(-320, -172, 1.5);\n    this.globo = p.globo(actividad.consigna, -235, 0, 220, { base: -62 });\n\n    // Enunciado\n    p.rectangulo(70, 130, 600, 100, c.blanco, { borde: c.granate, grosor: 2, radio: 14, sombra: true });\n    p.texto(actividad.enunciado, 70, 130, { ancla: \"centro\", tamano: 21, ancho: 560, alinear: \"center\", color: c.granate_oscuro });\n\n    if (actividad.tipo === \"verdadero_falso\") {\n      this.crear_opciones([\"Verdadero\", \"Falso\"], actividad, 2);\n    } else if (actividad.tipo === \"opcion_multiple\") {\n      this.crear_opciones(p.mezclar(actividad.opciones), actividad, 1);\n    } else {\n      p.texto(\"Utiliza el teclado para escribir tu respuesta y pulsa Enter.\", 100, 30, { ancla: \"centro\", tamano: 16, cursiva: true, color: c.rojo });\n      this.campo = p.campo_de_texto(100, -30, 320, (texto) => this.revisar_escrito(texto, actividad));\n      p.boton(\"Comprobar\", 100, -100, () => this.revisar_escrito(this.campo.valor, actividad), { ancho: 160, alto: 44, color: c.verde });\n    }\n  }\n\n  crear_opciones(opciones: string[], actividad: any, columnas: number) {\n    let p = this.proyecto;\n    let c = p.colores;\n\n    opciones.forEach((texto, i) => {\n      let x = columnas === 2 ? 15 + i * 240 : 70;\n      let y = columnas === 2 ? -10 : 30 - i * 68;\n\n      p.boton(texto, x, y, (boton) => {\n        if (this.resuelta) {\n          return;\n        }\n\n        if (texto === actividad.correcta) {\n          boton.cambiar_color(c.verde);\n          this.acierto(actividad);\n        } else {\n          boton.cambiar_color(c.rojo);\n          boton.desactivar();\n          this.error();\n        }\n      }, { ancho: 220, alto: 54, color: c.carbon, tamano: 20 });\n    });\n  }\n\n  revisar_escrito(texto: string, actividad: any) {\n    if (this.resuelta || texto.trim() === \"\") {\n      return;\n    }\n\n    if (this.proyecto.es_respuesta_correcta(texto, actividad.aceptadas)) {\n      this.campo.activo = false;\n      this.campo.actualizar();\n      this.acierto(actividad);\n    } else {\n      this.campo.limpiar();\n      this.error();\n    }\n  }\n\n  acierto(actividad: any) {\n    let p = this.proyecto;\n    this.resuelta = true;\n    this.pilas.reproducir_sonido(\"moneda\");\n    p.celebrar(this.guia);\n    this.cambiar_globo(\"¡Correcto! \" + actividad.explicacion, \"#E8F7EE\", p.colores.verde);\n\n    p.boton(\"Siguiente  ▶\", 190, -215, () => {\n      p.actividad_formativa += 1;\n\n      if (p.actividad_formativa < this.actividades.length) {\n        this.pilas.reiniciar_escena();\n      } else {\n        this.pilas.cambiar_escena(\"sopa_de_letras\");\n      }\n    }, { ancho: 180, alto: 48, color: p.colores.naranja });\n  }\n\n  error() {\n    this.pilas.reproducir_sonido(\"seleccion-grave\");\n    this.cambiar_globo(\"¡Casi! Inténtalo de nuevo.\", \"#FDECEA\", this.proyecto.colores.rojo);\n  }\n\n  cambiar_globo(mensaje: string, color: string, borde: string) {\n    this.globo.eliminar();\n    this.globo = this.proyecto.globo(mensaje, -235, 0, 230, { color: color, borde: borde, negrita: true, base: -62 });\n  }\n\n  cuando_pulsa_tecla(tecla: string, evento: any) {\n    if (this.campo) {\n      this.campo.recibir_tecla(evento);\n    }\n  }\n\n  actualizar() {}\n}\n"
      },
      {
        "nombre": "sopa_de_letras",
        "codigo": "// Escena 7: SOPA DE LETRAS (última actividad de la evaluación formativa)\n// Se hace clic en la PRIMERA y en la ÚLTIMA letra de cada palabra.\nclass sopa_de_letras extends Escena {\n  tamano_de_celda = 38;\n  izquierda = -60;   // borde izquierdo de la cuadrícula (coordenadas de pilas)\n  arriba = 185;      // borde superior de la cuadrícula\n\n  // Palabras escondidas: fila, columna inicial y dirección.\n  palabras = [\n    { palabra: \"NEGRITA\", fila: 0, columna: 0, horizontal: true },\n    { palabra: \"WORDART\", fila: 2, columna: 3, horizontal: true },\n    { palabra: \"COLUMNA\", fila: 4, columna: 0, horizontal: true },\n    { palabra: \"FUENTE\", fila: 7, columna: 4, horizontal: true },\n    { palabra: \"COPIAR\", fila: 8, columna: 1, horizontal: true },\n    { palabra: \"PEGAR\", fila: 9, columna: 0, horizontal: true },\n    { palabra: \"TABLA\", fila: 2, columna: 9, horizontal: false },\n    { palabra: \"PDF\", fila: 5, columna: 0, horizontal: false }\n  ];\n\n  relleno = \"QZMHUJXLBKYVSIEDRTNOAWPGCF\";\n  cuadricula: string[][] = [];\n  encontradas: any[] = [];\n  primera: any = null;\n  resaltado: any = null;\n  textos_de_lista: any = {};\n  globo: any = null;\n  guia: any = null;\n\n  iniciar() {\n    let p = this.proyecto;\n    let c = p.colores;\n\n    p.plantilla(\"Sopa de letras\", {\n      menu: true,\n      ayuda: \"Haz clic en la primera y en la última letra de cada palabra. Las palabras están escritas de izquierda a derecha o de arriba hacia abajo.\"\n    });\n    p.texto(\"Actividad 6 de 6\", 318, 265, { ancla: \"derecha\", tamano: 15, color: c.rosa_claro, negrita: true });\n\n    this.armar_cuadricula();\n    this.dibujar_cuadricula();\n\n    // Lista de palabras\n    p.rectangulo(-245, 95, 230, 210, c.blanco, { borde: c.granate, grosor: 2, radio: 12 });\n    p.texto(\"Encuentra:\", -340, 185, { tamano: 17, negrita: true, color: c.rojo });\n    this.palabras.forEach((item, i) => {\n      let x = -335 + (i % 2) * 108;\n      let y = 150 - Math.floor(i / 2) * 36;\n      this.textos_de_lista[item.palabra] = p.texto(item.palabra, x, y, { tamano: 16, negrita: true, color: c.granate_oscuro });\n    });\n\n    this.guia = p.guia(-320, -178, 1.4);\n    this.globo = p.globo(\"Haz clic en la primera y en la última letra de la palabra.\", -225, 0, 230, { base: -72 });\n\n    this.resaltado = this.pilas.modo.add.graphics();\n    this.resaltado.setDepth(3);\n\n    p.boton(\"Terminar  ▶\", -150, -240, () => this.pilas.cambiar_escena(\"felicitacion\"), { ancho: 170, alto: 42, tamano: 16, color: c.naranja });\n  }\n\n  armar_cuadricula() {\n    let semilla = 7;\n\n    for (let f = 0; f < 10; f++) {\n      this.cuadricula.push([]);\n      for (let col = 0; col < 10; col++) {\n        semilla = (semilla * 31 + 11) % 997;\n        this.cuadricula[f].push(this.relleno[semilla % this.relleno.length]);\n      }\n    }\n\n    this.palabras.forEach((item) => {\n      for (let i = 0; i < item.palabra.length; i++) {\n        let f = item.horizontal ? item.fila : item.fila + i;\n        let col = item.horizontal ? item.columna + i : item.columna;\n        this.cuadricula[f][col] = item.palabra[i];\n      }\n    });\n  }\n\n  centro_de_celda(fila: number, columna: number) {\n    let t = this.tamano_de_celda;\n    return { x: this.izquierda + columna * t + t / 2, y: this.arriba - fila * t - t / 2 };\n  }\n\n  dibujar_cuadricula() {\n    let p = this.proyecto;\n    let t = this.tamano_de_celda;\n    p.rectangulo(this.izquierda + 5 * t, this.arriba - 5 * t, 10 * t + 12, 10 * t + 12, p.colores.blanco, { borde: p.colores.granate, grosor: 3, radio: 8, sombra: true });\n\n    for (let f = 0; f < 10; f++) {\n      for (let col = 0; col < 10; col++) {\n        let centro = this.centro_de_celda(f, col);\n        p.rectangulo(centro.x, centro.y, t - 2, t - 2, \"#FFFFFF\", { borde: \"#E3E8EF\", grosor: 1, radio: 4, profundidad: 2 });\n        p.texto(this.cuadricula[f][col], centro.x, centro.y, { ancla: \"centro\", tamano: 20, negrita: true, color: \"#C2185B\", fuente: \"Georgia, serif\", profundidad: 6 });\n      }\n    }\n  }\n\n  // El click de la escena llega con coordenadas de pilas.\n  cuando_hace_click(x: number, y: number, evento: any) {\n    let t = this.tamano_de_celda;\n    let columna = Math.floor((x - this.izquierda) / t);\n    let fila = Math.floor((this.arriba - y) / t);\n\n    if (fila < 0 || fila > 9 || columna < 0 || columna > 9) {\n      return;\n    }\n\n    if (!this.primera) {\n      this.primera = { fila: fila, columna: columna };\n    } else {\n      this.comprobar(this.primera, { fila: fila, columna: columna });\n      this.primera = null;\n    }\n\n    this.redibujar_resaltado();\n  }\n\n  comprobar(a: any, b: any) {\n    let p = this.proyecto;\n\n    for (let i = 0; i < this.palabras.length; i++) {\n      let item = this.palabras[i];\n      let fin = {\n        fila: item.horizontal ? item.fila : item.fila + item.palabra.length - 1,\n        columna: item.horizontal ? item.columna + item.palabra.length - 1 : item.columna\n      };\n      let coincide =\n        (a.fila === item.fila && a.columna === item.columna && b.fila === fin.fila && b.columna === fin.columna) ||\n        (b.fila === item.fila && b.columna === item.columna && a.fila === fin.fila && a.columna === fin.columna);\n\n      if (coincide && this.encontradas.indexOf(item) === -1) {\n        this.encontradas.push(item);\n        this.pilas.reproducir_sonido(\"moneda\");\n        let texto = this.textos_de_lista[item.palabra];\n        texto.setColor(p.colores.verde);\n        texto.setText(\"✔ \" + item.palabra);\n\n        if (this.encontradas.length === this.palabras.length) {\n          p.celebrar(this.guia);\n          this.mostrar_mensaje(\"¡Excelente! Encontraste todas las palabras.\", \"#E8F7EE\", p.colores.verde);\n        } else {\n          this.mostrar_mensaje(\"¡Muy bien! Encontraste \" + item.palabra + \".\", \"#E8F7EE\", p.colores.verde);\n        }\n        return;\n      }\n    }\n\n    this.pilas.reproducir_sonido(\"seleccion-grave\");\n    this.mostrar_mensaje(\"Esa no es una palabra. ¡Inténtalo otra vez!\", \"#FDECEA\", p.colores.rojo);\n  }\n\n  mostrar_mensaje(mensaje: string, color: string, borde: string) {\n    this.globo.eliminar();\n    this.globo = this.proyecto.globo(mensaje, -225, 0, 230, { color: color, borde: borde, negrita: true, base: -72 });\n  }\n\n  redibujar_resaltado() {\n    let p = this.proyecto;\n    let t = this.tamano_de_celda;\n    let g = this.resaltado;\n    g.clear();\n\n    // Palabras encontradas: una franja verde semitransparente\n    this.encontradas.forEach((item) => {\n      let inicio = p.a_pantalla(this.centro_de_celda(item.fila, item.columna).x, this.centro_de_celda(item.fila, item.columna).y);\n      let largo = item.palabra.length * t - 6;\n      g.fillStyle(p.color_numerico(p.colores.verde), 0.35);\n      if (item.horizontal) {\n        g.fillRoundedRect(inicio.x - t / 2 + 3, inicio.y - t / 2 + 4, largo, t - 8, 14);\n      } else {\n        g.fillRoundedRect(inicio.x - t / 2 + 4, inicio.y - t / 2 + 3, t - 8, largo, 14);\n      }\n    });\n\n    // Primera letra elegida\n    if (this.primera) {\n      let centro = this.centro_de_celda(this.primera.fila, this.primera.columna);\n      let q = p.a_pantalla(centro.x, centro.y);\n      g.fillStyle(p.color_numerico(p.colores.naranja), 0.5);\n      g.fillCircle(q.x, q.y, t / 2 - 2);\n    }\n  }\n\n  actualizar() {}\n}\n"
      },
      {
        "nombre": "felicitacion",
        "codigo": "// Escena 8: FELICITACIÓN al terminar la evaluación formativa\nclass felicitacion extends Escena {\n  iniciar() {\n    let p = this.proyecto;\n    let c = p.colores;\n\n    p.plantilla(\"\");\n\n    // Trofeo: actor de pilas con una animación de entrada\n    let copa = this.pilas.actores.actor_basico(\"imagenes:objetos/copa\");\n    copa.x = 0;\n    copa.y = 120;\n    copa.escala = 0.2;\n    copa.z = -10;\n    copa.animar().escalar_hasta(1.7, 1);\n\n    this.pilas.reproducir_sonido(\"moneda\");\n\n    p.texto(\"¡Llegaste hasta aquí, eres un ganador!\", 0, 5, { ancla: \"centro\", tamano: 28, negrita: true, color: c.granate, fuente: \"Georgia, serif\" });\n    p.texto(\"Estoy muy orgulloso de ti. Espero que estas actividades te hayan ayudado a comprender cómo usar Word. Ahora puedes realizar la evaluación sumativa.\", 0, -60, {\n      ancla: \"centro\", tamano: 18, ancho: 600, alinear: \"center\"\n    });\n    p.texto(\"¡ÉXITOS!\", 0, -125, { ancla: \"centro\", tamano: 26, negrita: true, color: c.naranja });\n\n    let guia = p.guia(-300, -180, 1.5, \"manu\");\n    p.celebrar(guia);\n\n    p.boton(\"Continuar  ▶\", 260, -225, () => this.pilas.cambiar_escena(\"evaluacion\"), { ancho: 190, alto: 50, color: c.verde });\n  }\n\n  actualizar() {}\n}\n"
      },
      {
        "nombre": "sumativa",
        "codigo": "// Escena 9: EVALUACIÓN SUMATIVA (10 preguntas, 1 punto cada una)\n// Aquí hay un solo intento por pregunta y se acumula la calificación.\nclass sumativa extends Escena {\n  campo: any = null;\n  respondida = false;\n\n  preguntas = [\n    {\n      tipo: \"opcion_multiple\",\n      consigna: \"Selecciona la respuesta correcta:\",\n      enunciado: \"¿Cómo se llama la franja superior de Word que agrupa los comandos en pestañas?\",\n      opciones: [\"Cinta de opciones\", \"Barra de estado\", \"Regla\"],\n      correcta: \"Cinta de opciones\"\n    },\n    {\n      tipo: \"verdadero_falso\",\n      consigna: \"Indica si es Verdadero o Falso:\",\n      enunciado: \"En Word en español, el atajo Ctrl + N sirve para poner el texto en negrita.\",\n      correcta: \"Verdadero\"\n    },\n    {\n      tipo: \"opcion_multiple\",\n      consigna: \"Selecciona la respuesta correcta:\",\n      enunciado: \"¿Qué hace la opción Cortar (Ctrl + X)?\",\n      opciones: [\"Quita el texto para moverlo a otro lugar\", \"Duplica el texto\", \"Cambia el color del texto\"],\n      correcta: \"Quita el texto para moverlo a otro lugar\"\n    },\n    {\n      tipo: \"opcion_multiple\",\n      consigna: \"Selecciona la respuesta correcta:\",\n      enunciado: \"¿Dónde se escribe un texto que se repite en la parte superior de todas las páginas?\",\n      opciones: [\"Encabezado\", \"Pie de página\", \"Letra capital\"],\n      correcta: \"Encabezado\"\n    },\n    {\n      tipo: \"verdadero_falso\",\n      consigna: \"Indica si es Verdadero o Falso:\",\n      enunciado: \"La marca de agua es un texto o imagen clarito que aparece detrás del contenido de la página.\",\n      correcta: \"Verdadero\"\n    },\n    {\n      tipo: \"escribir\",\n      consigna: \"Escribe con el teclado:\",\n      enunciado: \"¿Cómo se llama la herramienta de Word para escribir texto artístico con efectos de color y sombra?\",\n      aceptadas: [\"wordart\", \"word art\"]\n    },\n    {\n      tipo: \"opcion_multiple\",\n      consigna: \"Selecciona la respuesta correcta:\",\n      enunciado: \"Para dividir el texto en dos partes, como en un periódico, usamos:\",\n      opciones: [\"Columnas\", \"Tablas\", \"Viñetas\"],\n      correcta: \"Columnas\"\n    },\n    {\n      tipo: \"verdadero_falso\",\n      consigna: \"Indica si es Verdadero o Falso:\",\n      enunciado: \"Las viñetas sirven para insertar tablas en el documento.\",\n      correcta: \"Falso\"\n    },\n    {\n      tipo: \"opcion_multiple\",\n      consigna: \"Selecciona la respuesta correcta:\",\n      enunciado: \"¿En qué pestaña se encuentra la opción Marca de agua?\",\n      opciones: [\"Diseño\", \"Inicio\", \"Archivo\"],\n      correcta: \"Diseño\"\n    },\n    {\n      tipo: \"escribir\",\n      consigna: \"Escribe con el teclado:\",\n      enunciado: \"¿Qué tecla se combina con las letras C, X y V para copiar, cortar y pegar?\",\n      aceptadas: [\"ctrl\", \"control\", \"tecla ctrl\", \"tecla control\"]\n    }\n  ];\n\n  iniciar() {\n    let p = this.proyecto;\n    let c = p.colores;\n    let indice = p.pregunta_sumativa;\n    let pregunta = this.preguntas[indice];\n\n    p.plantilla(\"Evaluación sumativa\", {\n      sin_logo: true,\n      ayuda: \"Tienes un solo intento en cada pregunta. Cada respuesta correcta suma 1 punto a tu calificación.\"\n    });\n\n    // Calificación acumulada (arriba a la derecha)\n    p.rectangulo(295, 265, 170, 34, c.blanco, { radio: 8 });\n    p.texto(\"Calificación\", 258, 265, { ancla: \"centro\", tamano: 14, negrita: true, color: c.granate });\n    p.rectangulo(345, 265, 50, 24, c.naranja, { radio: 6 });\n    p.texto(String(p.calificacion), 345, 265, { ancla: \"centro\", tamano: 16, negrita: true, color: c.blanco });\n\n    // Número de pregunta dentro de un círculo\n    let numero = indice + 1 < 10 ? \"0\" + (indice + 1) : String(indice + 1);\n    p.circulo(-290, 150, 52, c.blanco, { borde: c.verde, grosor: 8, sombra: true });\n    p.texto(numero, -290, 150, { ancla: \"centro\", tamano: 40, fuente: \"Georgia, serif\", color: c.texto });\n\n    p.rectangulo(70, 182, 600, 38, c.verde, { radio: 19 });\n    p.texto(pregunta.consigna, -215, 182, { ancla: \"izquierda\", tamano: 20, negrita: true, color: c.blanco });\n    p.texto(pregunta.enunciado, -215, 150, { tamano: 21, ancho: 560, color: c.texto, negrita: true });\n\n    if (pregunta.tipo === \"verdadero_falso\") {\n      [\"Verdadero\", \"Falso\"].forEach((texto, i) => this.crear_boton_de_respuesta(texto, -90 + i * 260, -20, pregunta));\n    } else if (pregunta.tipo === \"opcion_multiple\") {\n      p.mezclar(pregunta.opciones).forEach((texto, i) => this.crear_boton_de_respuesta(texto, 40, 30 - i * 72, pregunta));\n    } else {\n      p.texto(\"Utiliza el teclado y pulsa Enter (o el botón Responder).\", 40, 40, { ancla: \"centro\", tamano: 15, cursiva: true, color: c.rojo });\n      this.campo = p.campo_de_texto(40, -20, 380, (texto) => this.responder_escrito(texto, pregunta));\n      p.boton(\"Responder\", 40, -90, () => this.responder_escrito(this.campo.valor, pregunta), { ancho: 170, alto: 44, color: c.verde });\n    }\n  }\n\n  crear_boton_de_respuesta(texto: string, x: number, y: number, pregunta: any) {\n    let p = this.proyecto;\n    let ancho = texto.length > 20 ? 420 : 240;\n\n    p.boton(texto, x, y, (boton) => {\n      if (this.respondida) {\n        return;\n      }\n\n      let es_correcta = texto === pregunta.correcta;\n      boton.cambiar_color(es_correcta ? p.colores.verde : p.colores.rojo);\n      this.registrar(es_correcta);\n    }, { ancho: ancho, alto: 52, color: p.colores.blanco, color_del_texto: p.colores.granate_oscuro, borde: p.colores.rojo_unl, tamano: 18 });\n  }\n\n  responder_escrito(texto: string, pregunta: any) {\n    if (this.respondida || texto.trim() === \"\") {\n      return;\n    }\n\n    this.campo.activo = false;\n    this.campo.actualizar();\n    this.registrar(this.proyecto.es_respuesta_correcta(texto, pregunta.aceptadas));\n  }\n\n  // Suma el punto (si corresponde) y pasa a la siguiente pregunta.\n  registrar(es_correcta: boolean) {\n    let p = this.proyecto;\n    this.respondida = true;\n\n    if (es_correcta) {\n      p.calificacion += 1;\n      this.pilas.reproducir_sonido(\"moneda\");\n    } else {\n      this.pilas.reproducir_sonido(\"seleccion-grave\");\n    }\n\n    p.globo(es_correcta ? \"¡Correcto!\" : \"Respuesta incorrecta\", -290, 40, 170, {\n      color: es_correcta ? \"#E8F7EE\" : \"#FDECEA\",\n      borde: es_correcta ? p.colores.verde : p.colores.rojo,\n      negrita: true\n    });\n\n    this.pilas.luego(1.3, () => {\n      p.pregunta_sumativa += 1;\n\n      if (p.pregunta_sumativa < this.preguntas.length) {\n        this.pilas.reiniciar_escena();\n      } else {\n        this.pilas.cambiar_escena(\"resultado\");\n      }\n    });\n  }\n\n  cuando_pulsa_tecla(tecla: string, evento: any) {\n    if (this.campo) {\n      this.campo.recibir_tecla(evento);\n    }\n  }\n\n  actualizar() {}\n}\n"
      },
      {
        "nombre": "resultado",
        "codigo": "// Escena 10: RESULTADO de la evaluación sumativa\n// Escala de calificaciones del Ministerio de Educación del Ecuador.\nclass resultado extends Escena {\n  iniciar() {\n    let p = this.proyecto;\n    let c = p.colores;\n    let nota = p.calificacion;\n\n    p.plantilla(\"Resultado\");\n\n    p.texto(\"Estimado estudiante, después de haber desarrollado la evaluación, tu calificación es la siguiente:\", 0, 195, {\n      ancla: \"centro\", tamano: 20, negrita: true, color: c.carbon, ancho: 640, alinear: \"center\"\n    });\n\n    p.texto((nota < 10 ? \"0\" : \"\") + nota, -95, 85, { ancla: \"centro\", tamano: 96, color: c.granate, fuente: \"Georgia, serif\", negrita: true });\n    p.linea(-55, 10, 25, 150, c.granate, 6);\n    p.texto(\"10\", 70, 40, { ancla: \"centro\", tamano: 72, color: c.granate, fuente: \"Georgia, serif\", negrita: true });\n\n    let escala = \"\";\n    let mensaje = \"\";\n    let color = c.verde;\n\n    if (nota >= 9) {\n      escala = \"Domina los aprendizajes requeridos\";\n      mensaje = \"¡Excelente! Dominas las herramientas de Word. Sigue así.\";\n    } else if (nota >= 7) {\n      escala = \"Alcanza los aprendizajes requeridos\";\n      mensaje = \"¡Bien! El interés por los estudios se demuestra al obtener buenas calificaciones.\";\n    } else if (nota > 4) {\n      escala = \"Está próximo a alcanzar los aprendizajes requeridos\";\n      mensaje = \"¡Ánimo! Repasa los contenidos y vuelve a intentarlo.\";\n      color = c.naranja;\n    } else {\n      escala = \"No alcanza los aprendizajes requeridos\";\n      mensaje = \"Revisa nuevamente los contenidos con calma y vuelve a intentarlo. ¡Tú puedes!\";\n      color = c.rojo;\n    }\n\n    p.texto(escala, 270, 80, { ancla: \"centro\", tamano: 20, negrita: true, color: color, ancho: 230, alinear: \"center\" });\n    p.rectangulo(0, -85, 640, 80, c.blanco, { borde: color, grosor: 3, radio: 14 });\n    p.texto(mensaje, 0, -85, { ancla: \"centro\", tamano: 19, ancho: 600, alinear: \"center\" });\n\n    let guia = p.guia(-320, -175, 1.4);\n    if (nota >= 7) {\n      p.celebrar(guia);\n    }\n\n    p.boton(\"Repetir\", 60, -200, () => {\n      p.reiniciar_evaluaciones();\n      this.pilas.cambiar_escena(\"sumativa\");\n    }, { ancho: 150, alto: 46, color: c.rojo_unl });\n\n    p.boton(\"Continuar  ▶\", 250, -200, () => this.pilas.cambiar_escena(\"evaluacion\"), { ancho: 190, alto: 46, color: c.verde });\n  }\n\n  actualizar() {}\n}\n"
      },
      {
        "nombre": "creditos",
        "codigo": "// Escena 11: CRÉDITOS (los datos se cambian en el código del Proyecto)\nclass creditos extends Escena {\n  iniciar() {\n    let p = this.proyecto;\n    let c = p.colores;\n\n    p.plantilla(\"Créditos\", { menu: true });\n\n    // Columna izquierda: Manu y logotipos\n    p.imagen(\"manu_mapa\", -265, 95, 160);\n    p.rectangulo(-265, -95, 220, 74, c.blanco, { radio: 12, sombra: true, profundidad: 2 });\n    p.imagen(\"logo_unl\", -265, -95, 200);\n    p.rectangulo(-265, -185, 220, 64, c.blanco, { radio: 12, sombra: true, profundidad: 2 });\n    p.imagen(\"logo_uedl\", -265, -185, 200);\n\n    // Columna derecha: datos\n    let datos = [\n      { titulo: \"AUTOR:\", valor: p.autor + \"\\n\" + p.correo },\n      { titulo: \"ORGANIZACIÓN:\", valor: p.organizacion },\n      { titulo: \"INSTITUCIÓN EDUCATIVA:\", valor: p.institucion },\n      { titulo: \"AÑO:\", valor: p.periodo }\n    ];\n\n    let y = 205;\n    datos.forEach((dato) => {\n      p.texto(dato.titulo, 95, y, { ancla: \"arriba\", tamano: 18, negrita: true, color: c.granate, fuente: \"Georgia, serif\" });\n      let valor = p.texto(dato.valor, 95, y - 25, { ancla: \"arriba\", tamano: 16, ancho: 430, alinear: \"center\" });\n      y -= 45 + valor.height;\n    });\n\n    p.texto(\"Recurso desarrollado con pilas-engine 2 a partir del currículo del Área de Informática Educativa de las Escuelas Municipales de Loja.\", 75, -195, {\n      ancla: \"centro\", tamano: 12, cursiva: true, color: \"#6B5B5B\", ancho: 360, alinear: \"center\"\n    });\n\n    p.boton_redondo(\"▶\", 285, -235, 24, c.rojo_unl, () => this.pilas.cambiar_escena(\"licencia\"), 20);\n  }\n\n  actualizar() {}\n}\n"
      },
      {
        "nombre": "licencia",
        "codigo": "// Escena 12: LICENCIA Creative Commons\nclass licencia extends Escena {\n  iniciar() {\n    let p = this.proyecto;\n    let c = p.colores;\n\n    p.plantilla(\"Licencia\", { menu: true });\n\n    // Distintivo CC BY dibujado\n    p.rectangulo(0, 110, 200, 70, \"#ABB1AF\", { radio: 6, borde: \"#000000\", grosor: 3 });\n    p.rectangulo(45, 110, 110, 64, \"#000000\", { radio: 0 });\n    p.circulo(-55, 110, 26, c.blanco, { borde: \"#000000\", grosor: 4 });\n    p.texto(\"cc\", -55, 112, { ancla: \"centro\", tamano: 26, negrita: true, color: \"#000000\" });\n    p.circulo(45, 120, 16, c.blanco);\n    p.texto(\"i\", 45, 121, { ancla: \"centro\", tamano: 22, negrita: true, color: \"#000000\", fuente: \"Georgia, serif\" });\n    p.texto(\"BY\", 45, 92, { ancla: \"centro\", tamano: 15, negrita: true, color: c.blanco });\n\n    p.texto(\"Esta obra está bajo una licencia de Creative Commons Reconocimiento 4.0 Internacional (CC BY 4.0).\", 0, 20, {\n      ancla: \"centro\", tamano: 20, ancho: 600, alinear: \"center\", color: c.texto\n    });\n    p.texto(\"Puedes compartir y adaptar este recurso, siempre que menciones a su autor.\", 0, -45, {\n      ancla: \"centro\", tamano: 17, ancho: 600, alinear: \"center\", color: \"#52606D\"\n    });\n    p.texto(\"creativecommons.org/licenses/by/4.0/deed.es\", 0, -95, { ancla: \"centro\", tamano: 17, color: c.rojo_unl, negrita: true });\n\n    p.boton_redondo(\"◀\", 210, -235, 24, c.rojo_unl, () => this.pilas.cambiar_escena(\"creditos\"), 20);\n    p.boton_redondo(\"▶\", 270, -235, 24, c.rojo_unl, () => this.pilas.cambiar_escena(\"bibliografia\"), 20);\n  }\n\n  actualizar() {}\n}\n"
      },
      {
        "nombre": "bibliografia",
        "codigo": "// Escena 13: REFERENCIAS BIBLIOGRÁFICAS\nclass bibliografia extends Escena {\n  iniciar() {\n    let p = this.proyecto;\n    let c = p.colores;\n\n    p.plantilla(\"Referencias bibliográficas\", { menu: true });\n\n    let referencias = [\n      \"Coordinación de Informática Educativa. (2021). Currículo del Área de Informática Educativa de las Escuelas Municipales de Loja. Loja, Ecuador.\",\n      \"Ministerio de Educación del Ecuador. (2016). Currículo de los Niveles de Educación Obligatoria. Quito, Ecuador.\",\n      \"Microsoft. (s.f.). Ayuda y aprendizaje de Word. https://support.microsoft.com/es-es/word\",\n      \"Ruscitti, H. (s.f.). Pilas Engine: manual de uso. https://pilas-engine.com.ar\",\n      \"Universidad Nacional de Loja. (2026). Pedagogía de las Ciencias Experimentales: Informática [Brochure]. Unidad de Educación a Distancia y en Línea. https://unl.edu.ec\"\n    ];\n\n    let y = 200;\n    referencias.forEach((referencia) => {\n      let texto = p.texto(referencia, -330, y, { tamano: 17, ancho: 640, interlineado: 4 });\n      y -= texto.height + 22;\n    });\n\n    p.boton_redondo(\"◀\", 270, -235, 24, c.rojo_unl, () => this.pilas.cambiar_escena(\"licencia\"), 20);\n  }\n\n  actualizar() {}\n}\n"
      }
    ],
    "actores": [],
    "proyecto": "// =====================================================================\n//  RECURSO EDUCATIVO DIGITAL (RED): \"Utilizando Office: Word\"\n//  Informática Educativa - Subnivel Medio (Sexto grado EGB)\n//  Currículo del Área de Informática Educativa de las Escuelas\n//  Municipales de Loja - Bloque 3: Ofimática (IE.3.3.1 a IE.3.3.11)\n//\n//  Código del PROYECTO: aquí se guardan los datos que se comparten\n//  entre todas las escenas (calificación, página actual, etc.) y las\n//  funciones de ayuda para dibujar textos, paneles y botones.\n//  Desde cualquier escena se accede con:  this.proyecto\n// =====================================================================\n\nclass Proyecto {\n  pilas: any;\n\n  // ---------- Datos de los créditos ----------\n  autor = \"Diego F. Ortiz\";\n  correo = \"diego.f.ortiz@unl.edu.ec\";\n  institucion = \"Escuelas Municipales de Loja\\n(Área de Informática Educativa)\";\n  organizacion = \"Carrera de Pedagogía de las Ciencias Experimentales: Informática\\nUnidad de Educación a Distancia y en Línea\\nUniversidad Nacional de Loja\";\n  periodo = \"2026\";\n\n  // ---------- Colores institucionales de la UNL (tomados del brochure) ----------\n  colores = {\n    granate: \"#9B1B1F\",         // color principal\n    granate_oscuro: \"#6C1216\",  // cabeceras y barras\n    rosa_claro: \"#F1DFDE\",      // fondos suaves\n    rojo_unl: \"#C4161C\",        // botones secundarios\n    naranja: \"#F6921E\",\n    amarillo: \"#FFC94A\",\n    verde: \"#2E9E4F\",           // respuestas correctas\n    rojo: \"#D93025\",            // respuestas incorrectas\n    carbon: \"#3A3F4A\",\n    word: \"#2B579A\",            // azul de Word (solo para los dibujos de Word)\n    blanco: \"#FFFFFF\",\n    crema: \"#FAF6F5\",\n    borde: \"#ECD2D0\",\n    texto: \"#2B2F36\"\n  };\n\n  // ---------- Estado compartido entre escenas ----------\n  pagina_de_contenidos = 0;   // página actual de la escena \"contenidos\"\n  actividad_formativa = 0;    // actividad actual de la evaluación formativa\n  pregunta_sumativa = 0;      // pregunta actual de la evaluación sumativa\n  calificacion = 0;           // aciertos de la evaluación sumativa\n\n  constructor(pilas: any) {\n    this.pilas = pilas;\n  }\n\n  iniciar() {\n    this.reiniciar_evaluaciones();\n  }\n\n  reiniciar_evaluaciones() {\n    this.actividad_formativa = 0;\n    this.pregunta_sumativa = 0;\n    this.calificacion = 0;\n  }\n\n  // =================================================================\n  //  UTILIDADES DE DIBUJO\n  //  Pilas usa coordenadas con el (0, 0) en el centro de la pantalla\n  //  (x hacia la derecha, y hacia arriba). La pantalla mide 800 x 600,\n  //  así que x va de -400 a 400 e y va de -300 a 300.\n  // =================================================================\n\n  a_pantalla(x: number, y: number) {\n    return this.pilas.utilidades.convertir_coordenada_de_pilas_a_phaser(x, y);\n  }\n\n  color_numerico(color: string) {\n    return parseInt(color.replace(\"#\", \"\"), 16);\n  }\n\n  // Escribe un texto. Opciones: tamano, color, negrita, cursiva,\n  // ancho (para que el texto salte de línea), alinear (\"left\",\n  // \"center\", \"right\"), ancla (\"arriba_izquierda\", \"arriba\", \"centro\",\n  // \"izquierda\", \"derecha\"),\n  // fuente y profundidad.\n  texto(contenido: string, x: number, y: number, opciones: any = {}) {\n    let p = this.a_pantalla(x, y);\n    let estilo_de_fuente = \"normal\";\n\n    if (opciones.negrita && opciones.cursiva) {\n      estilo_de_fuente = \"bold italic\";\n    } else if (opciones.negrita) {\n      estilo_de_fuente = \"bold\";\n    } else if (opciones.cursiva) {\n      estilo_de_fuente = \"italic\";\n    }\n\n    let estilo: any = {\n      fontFamily: opciones.fuente || \"Arial, Helvetica, sans-serif\",\n      fontSize: (opciones.tamano || 18) + \"px\",\n      color: opciones.color || this.colores.texto,\n      fontStyle: estilo_de_fuente,\n      align: opciones.alinear || \"left\",\n      lineSpacing: opciones.interlineado || 4\n    };\n\n    if (opciones.ancho) {\n      estilo.wordWrap = { width: opciones.ancho, useAdvancedWrap: false };\n    }\n\n    let texto = this.pilas.modo.add.text(p.x, p.y, contenido, estilo);\n    let ancla = opciones.ancla || \"arriba_izquierda\";\n\n    if (ancla === \"centro\") {\n      texto.setOrigin(0.5, 0.5);\n    } else if (ancla === \"arriba\") {\n      texto.setOrigin(0.5, 0);\n    } else if (ancla === \"izquierda\") {\n      texto.setOrigin(0, 0.5);\n    } else if (ancla === \"derecha\") {\n      texto.setOrigin(1, 0);\n    } else {\n      texto.setOrigin(0, 0);\n    }\n\n    texto.setDepth(opciones.profundidad || 10);\n    return texto;\n  }\n\n  // Dibuja un rectángulo con esquinas redondeadas. (x, y) es el centro.\n  rectangulo(x: number, y: number, ancho: number, alto: number, color: string, opciones: any = {}) {\n    let p = this.a_pantalla(x, y);\n    let g = this.pilas.modo.add.graphics();\n    let radio = opciones.radio === undefined ? 12 : opciones.radio;\n    let izquierda = p.x - ancho / 2;\n    let arriba = p.y - alto / 2;\n\n    if (opciones.sombra) {\n      g.fillStyle(0x000000, 0.18);\n      g.fillRoundedRect(izquierda + 4, arriba + 5, ancho, alto, radio);\n    }\n\n    g.fillStyle(this.color_numerico(color), opciones.opacidad === undefined ? 1 : opciones.opacidad);\n    g.fillRoundedRect(izquierda, arriba, ancho, alto, radio);\n\n    if (opciones.borde) {\n      g.lineStyle(opciones.grosor || 2, this.color_numerico(opciones.borde), 1);\n      g.strokeRoundedRect(izquierda, arriba, ancho, alto, radio);\n    }\n\n    g.setDepth(opciones.profundidad || 1);\n    return g;\n  }\n\n  circulo(x: number, y: number, radio: number, color: string, opciones: any = {}) {\n    let p = this.a_pantalla(x, y);\n    let g = this.pilas.modo.add.graphics();\n\n    if (opciones.sombra) {\n      g.fillStyle(0x000000, 0.18);\n      g.fillCircle(p.x + 3, p.y + 4, radio);\n    }\n\n    g.fillStyle(this.color_numerico(color), 1);\n    g.fillCircle(p.x, p.y, radio);\n\n    if (opciones.borde) {\n      g.lineStyle(opciones.grosor || 3, this.color_numerico(opciones.borde), 1);\n      g.strokeCircle(p.x, p.y, radio);\n    }\n\n    g.setDepth(opciones.profundidad || 1);\n    return g;\n  }\n\n  linea(x1: number, y1: number, x2: number, y2: number, color: string, grosor: number = 2, profundidad: number = 2) {\n    let a = this.a_pantalla(x1, y1);\n    let b = this.a_pantalla(x2, y2);\n    let g = this.pilas.modo.add.graphics();\n    g.lineStyle(grosor, this.color_numerico(color), 1);\n    g.lineBetween(a.x, a.y, b.x, b.y);\n    g.setDepth(profundidad);\n    return g;\n  }\n\n  // =================================================================\n  //  BOTÓN\n  //  El dibujo se hace con gráficos y el click lo recibe un actor de\n  //  pilas invisible, usando los eventos cuando_hace_click,\n  //  cuando_mueve y cuando_sale.\n  // =================================================================\n  boton(etiqueta: string, x: number, y: number, accion: any, opciones: any = {}) {\n    let ancho = opciones.ancho || 200;\n    let alto = opciones.alto || 48;\n    let color = opciones.color || this.colores.granate;\n    let color_del_texto = opciones.color_del_texto || this.colores.blanco;\n    let radio = opciones.radio === undefined ? 14 : opciones.radio;\n    let profundidad = opciones.profundidad || 5;\n    let p = this.a_pantalla(x, y);\n    let proyecto = this;\n\n    let fondo = this.pilas.modo.add.graphics();\n    fondo.setDepth(profundidad);\n\n    let texto = this.texto(etiqueta, x, y, {\n      ancla: \"centro\",\n      alinear: \"center\",\n      ancho: ancho - 16,\n      tamano: opciones.tamano || 18,\n      negrita: opciones.negrita === undefined ? true : opciones.negrita,\n      color: color_del_texto,\n      profundidad: profundidad + 1\n    });\n\n    let boton: any = {\n      color: color,\n      color_del_texto: color_del_texto,\n      activo: true,\n      resaltado: false,\n      fondo: fondo,\n      texto: texto,\n      actor: null,\n\n      dibujar() {\n        let elevacion = boton.resaltado ? -3 : 0;\n        fondo.clear();\n        fondo.fillStyle(0x000000, 0.2);\n        fondo.fillRoundedRect(p.x - ancho / 2 + 3, p.y - alto / 2 + 5, ancho, alto, radio);\n        fondo.fillStyle(proyecto.color_numerico(boton.color), boton.activo ? 1 : 0.55);\n        fondo.fillRoundedRect(p.x - ancho / 2, p.y - alto / 2 + elevacion, ancho, alto, radio);\n\n        if (opciones.borde) {\n          fondo.lineStyle(2, proyecto.color_numerico(opciones.borde), 1);\n          fondo.strokeRoundedRect(p.x - ancho / 2, p.y - alto / 2 + elevacion, ancho, alto, radio);\n        }\n\n        if (boton.resaltado) {\n          fondo.lineStyle(3, 0xffffff, 0.9);\n          fondo.strokeRoundedRect(p.x - ancho / 2 + 3, p.y - alto / 2 + 3 + elevacion, ancho - 6, alto - 6, radio - 3);\n        }\n\n        texto.y = p.y + elevacion;\n        texto.setColor(boton.color_del_texto);\n      },\n\n      cambiar_color(nuevo_color: string, nuevo_color_de_texto: string = null) {\n        boton.color = nuevo_color;\n        if (nuevo_color_de_texto) {\n          boton.color_del_texto = nuevo_color_de_texto;\n        }\n        boton.dibujar();\n      },\n\n      desactivar() {\n        boton.activo = false;\n        boton.resaltado = false;\n        boton.dibujar();\n      }\n    };\n\n    // Actor de pilas que recibe los eventos del mouse.\n    let actor = this.pilas.actores.actor_basico(\"imagenes:basicos/invisible\");\n    actor.x = x;\n    actor.y = y;\n    actor.z = -profundidad;\n    actor.sprite.input.hitArea.setTo(actor.sprite.width / 2 - ancho / 2, actor.sprite.height / 2 - alto / 2, ancho, alto);\n    boton.actor = actor;\n\n    actor.cuando_mueve = () => {\n      if (boton.activo && !boton.resaltado) {\n        boton.resaltado = true;\n        proyecto.pilas.definir_cursor(\"pointer\");\n        boton.dibujar();\n      }\n    };\n\n    actor.cuando_sale = () => {\n      boton.resaltado = false;\n      proyecto.pilas.definir_cursor(\"normal\");\n      boton.dibujar();\n    };\n\n    actor.cuando_hace_click = () => {\n      if (boton.activo) {\n        proyecto.pilas.definir_cursor(\"normal\");\n        proyecto.pilas.reproducir_sonido(\"seleccion-aguda\");\n        accion(boton);\n      }\n    };\n\n    boton.dibujar();\n    return boton;\n  }\n\n  // Botón redondo (por ejemplo el de ayuda \"?\" o el de \"Menú\").\n  boton_redondo(etiqueta: string, x: number, y: number, radio: number, color: string, accion: any, tamano: number = 22) {\n    return this.boton(etiqueta, x, y, accion, {\n      ancho: radio * 2,\n      alto: radio * 2,\n      radio: radio,\n      color: color,\n      tamano: tamano,\n      borde: \"#FFFFFF\"\n    });\n  }\n\n  // =================================================================\n  //  PERSONAJE GUÍA Y GLOBOS DE DIÁLOGO\n  // =================================================================\n\n  // Variantes de MANU, el oso mascota de la UNL (imágenes del proyecto)\n  // y su alto en píxeles, para que todas se vean del mismo tamaño:\n  //   manu_saludo -> Manu saludando (guía de las actividades)\n  //   manu        -> Manu celebrando con los brazos arriba\n  //   manu_laptop -> Manu con su laptop (portada)\n  //   manu_mano   -> Manu dando la bienvenida (menú)\n  altos_de_manu = { manu: 300, manu_saludo: 272, manu_laptop: 402, manu_mano: 354 };\n\n  // Crea a Manu como un actor de pilas. \"escala\" 1 equivale a unos 96 píxeles de alto.\n  guia(x: number, y: number, escala: number = 1.4, variante: string = \"manu_saludo\") {\n    let actor = this.pilas.actores.actor_basico(variante);\n    actor.x = x;\n    actor.y = y;\n    actor.z = -15;\n    actor[\"alto_deseado\"] = 96 * escala;\n    actor.escala = actor[\"alto_deseado\"] / this.altos_de_manu[variante];\n    return actor;\n  }\n\n  // Cambia la imagen de Manu sin cambiar su tamaño en pantalla.\n  cambiar_variante(actor: any, variante: string) {\n    actor.imagen = variante;\n    actor.escala = actor[\"alto_deseado\"] / this.altos_de_manu[variante];\n  }\n\n  // Manu levanta los brazos, salta y se balancea cuando el estudiante acierta.\n  celebrar(actor: any) {\n    let y = actor.y;\n    this.cambiar_variante(actor, \"manu\");\n    actor.animar().mover_y_hasta(y + 30, 0.2).mover_y_hasta(y, 0.2).rotar_hasta(-8, 0.15).rotar_hasta(8, 0.3).rotar_hasta(0, 0.15);\n  }\n\n  // Muestra una imagen del proyecto (logos, Manu...) con el ancho indicado.\n  imagen(nombre: string, x: number, y: number, ancho: number, profundidad: number = 8) {\n    let p = this.a_pantalla(x, y);\n    let imagen = this.pilas.modo.add.image(p.x, p.y, nombre);\n    imagen.setScale(ancho / imagen.width);\n    imagen.setDepth(profundidad);\n    return imagen;\n  }\n\n  // Dibuja un globo de diálogo. Devuelve un objeto con el método eliminar().\n  // Opciones: color, borde, negrita, tamano, colita (\"izquierda\"/\"derecha\") y base.\n  globo(mensaje: string, x: number, y: number, ancho: number = 240, opciones: any = {}) {\n    let texto = this.texto(mensaje, x, y, {\n      ancla: \"centro\",\n      alinear: \"center\",\n      ancho: ancho - 24,\n      tamano: opciones.tamano || 16,\n      color: opciones.color_del_texto || this.colores.texto,\n      negrita: opciones.negrita,\n      profundidad: 41\n    });\n\n    let alto = texto.height + 22;\n\n    // Si se indica \"base\", el globo crece hacia arriba desde esa altura.\n    if (opciones.base !== undefined) {\n      y = opciones.base + alto / 2;\n      let centro = this.a_pantalla(x, y);\n      texto.setPosition(centro.x, centro.y);\n    }\n\n    let p = this.a_pantalla(x, y);\n    let g = this.pilas.modo.add.graphics();\n    let color = this.color_numerico(opciones.color || \"#FFFFFF\");\n    let borde = this.color_numerico(opciones.borde || this.colores.granate);\n\n    g.fillStyle(0x000000, 0.15);\n    g.fillRoundedRect(p.x - ancho / 2 + 3, p.y - alto / 2 + 4, ancho, alto, 16);\n    g.fillStyle(color, 1);\n    g.lineStyle(3, borde, 1);\n    g.fillRoundedRect(p.x - ancho / 2, p.y - alto / 2, ancho, alto, 16);\n    g.strokeRoundedRect(p.x - ancho / 2, p.y - alto / 2, ancho, alto, 16);\n\n    // Colita del globo (apunta hacia la izquierda-abajo, donde está el guía).\n    let lado = opciones.colita === \"derecha\" ? 1 : -1;\n    let cx = p.x + lado * (ancho / 2 - 40);\n    let cy = p.y + alto / 2;\n    g.fillTriangle(cx - 12, cy - 2, cx + 12, cy - 2, cx + lado * 24, cy + 20);\n    g.lineBetween(cx - 12, cy, cx + lado * 24, cy + 20);\n    g.lineBetween(cx + 12, cy, cx + lado * 24, cy + 20);\n    g.setDepth(40);\n\n    return {\n      eliminar() {\n        texto.destroy();\n        g.destroy();\n      }\n    };\n  }\n\n  // =================================================================\n  //  PLANTILLA COMÚN DE LAS PANTALLAS (identidad visual UNL)\n  //  Dibuja la cabecera granate con el título y el logo \"unl\", la barra\n  //  inferior con el lema \"Educamos para Transformar\" y, si se indica,\n  //  el botón de ayuda \"?\" y el botón \"Menú\".\n  // =================================================================\n  plantilla(titulo: string, opciones: any = {}) {\n    let c = this.colores;\n    this.pilas.definir_cursor(\"normal\");\n\n    // Fondo crema con círculos decorativos como en el brochure\n    this.rectangulo(0, 0, 800, 600, c.crema, { radio: 0, profundidad: -50 });\n    let g = this.pilas.modo.add.graphics();\n    for (let i = 0; i < 4; i++) {\n      g.lineStyle(14, this.color_numerico(c.borde), 0.55);\n      g.strokeCircle(800, 600, 70 + i * 45);\n    }\n    g.setDepth(-49);\n    this.rectangulo(-392, 0, 16, 600, c.granate, { radio: 0, profundidad: -48 });\n    this.rectangulo(-378, 0, 6, 600, c.amarillo, { radio: 0, profundidad: -48 });\n\n    // Cabecera\n    if (titulo) {\n      this.rectangulo(0, 265, 800, 70, c.granate, { radio: 0, profundidad: -40 });\n      let franja = this.pilas.modo.add.graphics();\n      franja.fillStyle(this.color_numerico(c.granate_oscuro), 1);\n      franja.fillTriangle(560, 0, 800, 0, 800, 70);\n      franja.fillStyle(this.color_numerico(c.rojo_unl), 1);\n      franja.fillRect(0, 66, 800, 4);\n      franja.setDepth(-39);\n      this.texto(titulo, 0, 265, {\n        ancla: \"centro\",\n        tamano: 28,\n        negrita: true,\n        color: c.blanco,\n        fuente: \"Georgia, 'Times New Roman', serif\"\n      });\n\n      if (!opciones.sin_logo) {\n        this.imagen(\"unl_blanco\", 360, 265, 54, 9);\n      }\n    }\n\n    // Barra inferior\n    this.rectangulo(0, -287, 800, 26, c.granate_oscuro, { radio: 0, profundidad: -40 });\n    this.imagen(\"educamos_blanco\", -290, -287, 140, -39);\n    this.texto(\"Informática Educativa  ·  Subnivel Medio  ·  Bloque 3: Ofimática  ·  UNL\", 90, -287, {\n      ancla: \"centro\",\n      tamano: 12,\n      color: c.rosa_claro\n    });\n\n    if (opciones.ayuda) {\n      this.agregar_ayuda(opciones.ayuda, opciones.posicion_ayuda);\n    }\n\n    if (opciones.menu) {\n      this.boton_redondo(\"Menú\", 345, -235, 34, c.granate, () => {\n        this.pilas.cambiar_escena(\"menu\");\n      }, 15);\n    }\n  }\n\n  // Botón \"?\" que muestra u oculta un globo con instrucciones.\n  agregar_ayuda(mensaje: string, posicion: any = null) {\n    let globo = null;\n    let x = posicion ? posicion.x : -330;\n    let y = posicion ? posicion.y : 265;\n\n    this.boton_redondo(\"?\", x, y, 22, this.colores.rojo_unl, () => {\n      if (globo) {\n        globo.eliminar();\n        globo = null;\n      } else {\n        globo = this.globo(mensaje, x + 160, y - 70, 280, { colita: \"izquierda\" });\n      }\n    }, 24);\n  }\n\n  // =================================================================\n  //  CAMPO DE TEXTO (para preguntas en las que se escribe la respuesta)\n  //  La escena debe reenviar las teclas con:\n  //    cuando_pulsa_tecla(tecla, evento) { this.campo.recibir_tecla(evento); }\n  // =================================================================\n  campo_de_texto(x: number, y: number, ancho: number, al_pulsar_enter: any) {\n    let proyecto = this;\n    this.rectangulo(x, y, ancho, 50, \"#FFFFFF\", { borde: this.colores.granate, grosor: 3, radio: 10, profundidad: 3 });\n    let texto = this.texto(\"\", x - ancho / 2 + 16, y + 13, { tamano: 22, color: this.colores.texto, profundidad: 4 });\n    let pista = this.texto(\"Escribe aquí tu respuesta...\", x - ancho / 2 + 16, y + 13, { tamano: 20, color: \"#9AA5B1\", cursiva: true, profundidad: 4 });\n\n    let campo: any = {\n      valor: \"\",\n      activo: true,\n\n      actualizar() {\n        texto.setText(campo.valor + (campo.activo ? \"|\" : \"\"));\n        pista.setVisible(campo.valor.length === 0);\n      },\n\n      recibir_tecla(evento: any) {\n        if (!campo.activo) {\n          return;\n        }\n\n        let tecla = evento.key;\n\n        if (tecla === \"Backspace\") {\n          campo.valor = campo.valor.slice(0, -1);\n        } else if (tecla === \"Enter\") {\n          al_pulsar_enter(campo.valor);\n        } else if (tecla && tecla.length === 1 && campo.valor.length < 30) {\n          campo.valor += tecla;\n        }\n\n        campo.actualizar();\n      },\n\n      limpiar() {\n        campo.valor = \"\";\n        campo.actualizar();\n      }\n    };\n\n    campo.actualizar();\n    return campo;\n  }\n\n  // Quita tildes, espacios y mayúsculas para comparar respuestas escritas.\n  normalizar(texto: string) {\n    let resultado = texto.toLowerCase().trim();\n    let reemplazos = { \"á\": \"a\", \"é\": \"e\", \"í\": \"i\", \"ó\": \"o\", \"ú\": \"u\", \"ü\": \"u\", \".\": \"\", \" \": \"\", \"-\": \"\", \"+\": \"\" };\n\n    for (let letra in reemplazos) {\n      resultado = resultado.split(letra).join(reemplazos[letra]);\n    }\n\n    return resultado;\n  }\n\n  es_respuesta_correcta(escrita: string, aceptadas: string[]) {\n    let normalizada = this.normalizar(escrita);\n\n    for (let i = 0; i < aceptadas.length; i++) {\n      if (this.normalizar(aceptadas[i]) === normalizada) {\n        return true;\n      }\n    }\n\n    return false;\n  }\n\n  // Desordena una lista (para mostrar las opciones en distinto orden).\n  mezclar(lista: any[]) {\n    let copia = lista.slice();\n\n    for (let i = copia.length - 1; i > 0; i--) {\n      let j = Math.floor(Math.random() * (i + 1));\n      let temporal = copia[i];\n      copia[i] = copia[j];\n      copia[j] = temporal;\n    }\n\n    return copia;\n  }\n}\n"
  },
  "escenas": [
    {
      "nombre": "portada",
